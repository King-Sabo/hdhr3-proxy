[Unit]
Description=hdhr3-proxy (HDHR3 to Plex bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hdhr3-proxy
Group=hdhr3-proxy
WorkingDirectory=/opt/hdhr3-proxy
ExecStart=/opt/hdhr3-proxy/run.sh
Restart=on-failure
RestartSec=15
StateDirectory=hdhr3-proxy

# Streaming is inbound UDP on an ephemeral port; keep the sandbox loose enough.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
